{
  "name": "@replay/infra",
  "private": true,
  "version": "0.1.0",
  "description": "AWS CDK for Replay: ReplayCloud (deployed, docs/aws-deploy.md) plus synth-only skeletons (docs/aws-integrations.md).",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "synth": "cdk synth --quiet -c stubBuilds=true -c skeletons=true",
    "test": "tsx --test test/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "aws-cdk": "^2.1144.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.272.0",
    "constructs": "^10.8.1"
  }
}
