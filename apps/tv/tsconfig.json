{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    // Type-check imports against the native variant (Media.native.tsx); the .web.tsx
    // files are checked too because `include` picks them up, and both implement the
    // same exported types.
    "moduleSuffixes": [".native", ""],
    "types": ["node"],
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true
  },
  "include": ["src", "specs", "e2e", "e2e-evidence", "index.js", "vite.config.ts", "playwright.config.ts"]
}
